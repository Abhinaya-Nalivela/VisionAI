# =========================================================
# Python
# =========================================================
__pycache__/
**/__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so

# Virtual environments
.venv/
venv/
env/

# =========================================================
# Environment files / secrets
# =========================================================
.env
backend/.env
frontend/.env

# Keep environment templates
!.env.example
!backend/.env.example
!frontend/.env.example

# =========================================================
# Python testing / tooling
# =========================================================
.pytest_cache/
**/.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# =========================================================
# Backend runtime data
# =========================================================
backend/visionai.db
backend/*.db

backend/uploads/*
!backend/uploads/.gitkeep

backend/data/*
!backend/data/.gitkeep

# =========================================================
# Dataset
# =========================================================

# Large generated synthetic dataset
backend/dataset/generated/

# Large local KonIQ working subset
backend/dataset/koniq_source/

# We intentionally KEEP:
# backend/dataset/source/
# backend/dataset/koniq_selection.csv
# sample_images/

# =========================================================
# ML temporary artifacts
# =========================================================
backend/artifacts/*.pkl
backend/artifacts/*.npy

# IMPORTANT:
# Do NOT ignore *.joblib.
# quality_model_6class.joblib is required for inference.

# =========================================================
# Frontend
# =========================================================
frontend/node_modules/
frontend/dist/

# =========================================================
# IDE / OS
# =========================================================
.vscode/
.idea/
.DS_Store
Thumbs.db

# =========================================================
# Logs
# =========================================================
*.log